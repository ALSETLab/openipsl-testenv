# Site settings for the OpenIPSL Linux verification kit.
# Copy this file to site.env (same folder) and edit the values for your computer.
# Shell syntax: KEY=value, quote values that contain spaces. Both bash (the provisioning steps)
# and windows/New-VerifyDistro.ps1 read this file. Paths of installers are as seen from WSL (/mnt/<drive>/...).

# WSL distro: the image from "wsl --list --online", the name to give it, and an optional folder
# for its virtual disk (empty = the WSL default under %LOCALAPPDATA%\wsl).
DISTRO_IMAGE=Ubuntu-24.04
DISTRO_NAME=openipsl-verify-24.04
DISTRO_LOCATION=

# The normal user inside the distro. It gets no password and no sudo: root work goes through
# "wsl -d <distro> -u root", which windows/New-VerifyDistro.ps1 does for the root steps.
LINUX_USER=user

# OpenModelica release, installed from the archived release repository of build.openmodelica.org.
OM_VERSION=1.27.1

# Dymola for Linux: the vendor zip (it holds the RPM packages) and the FlexNet licence server.
DYMOLA_ZIP="/mnt/c/Installers/Dymola_2026x_Refresh1.AM_CAT_Dymola.Linux64.1-1.zip"
DYMOLA_RPM=dymola-2026.2-1.x86_64.rpm
DYMOLA_DIR=/opt/dymola-2026xRefresh1-x86_64
DYMOLA_LICENSE_HOST=license.example.org
DYMOLA_LICENSE_PORT=27000

# Wolfram System Modeler for Linux: the vendor .sh installer, the install folder, and the MathLM
# network licence server that serves System Modeler seats.
WSM_INSTALLER="/mnt/c/Installers/SystemModeler_15_LIN.sh"
WSM_TARGET=/usr/local/Wolfram/SystemModeler/15.0
WSM_LICENSE_SERVER=mathlm.example.org

# The OpenIPSL git repository (read only; the tests export a commit from it with git archive).
OPENIPSL_REPO=/mnt/c/git/OpenIPSL

# Optional, only for comparing the Linux runs with a Windows verification record (tests/<tool>/run_all.sh):
# the Windows record with one folder per tool (<root>/dymola, <root>/openmodelica, <root>/systemmodeler holding the
# CSV and metrics files), and the Windows raw results with the same per-tool folders. Empty = comparison skipped.
WINDOWS_RECORD_ROOT=
WINDOWS_RAW_ROOT=
